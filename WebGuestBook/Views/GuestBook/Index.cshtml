@model IEnumerable<WebGuestBook.Models.Review.Review>

@{
    ViewData["Title"] = "Головна – Відгуки";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-lg-8">

        <!-- Заголовок -->
        <div class="text-center mb-5">
            <h1 class="display-6 fw-bold text-warning mb-2">Гостьова Книга</h1>
            <p class="text-secondary">Діліться враженнями та читайте відгуки інших відвідувачів</p>
        </div>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <!-- Форма отправки только для авторизованных -->
            <div class="card bg-black bg-opacity-75 border border-secondary border-opacity-25 shadow-lg rounded-4 p-4 mb-5">
                <h5 class="text-light fw-bold mb-3 d-flex align-items-center gap-2">
                    <span>✏️</span> Залишити відгук
                </h5>

                <form asp-action="AddReview" method="post">
                    @Html.AntiForgeryToken()

                    <div class="alert alert-dark border-secondary border-opacity-25 py-2 px-3 mb-3 d-flex align-items-center gap-2 text-secondary small rounded-3">
                        <span>👤 Автор:</span>
                        <strong class="text-warning">@User.Identity.Name</strong>
                    </div>

                    <div class="mb-3">
                        <label for="message" class="form-label text-light small fw-semibold">Ваше повідомлення</label>
                        <textarea class="form-control bg-dark border-secondary border-opacity-50 text-light rounded-3 shadow-none focus-warning" 
                                  id="message" 
                                  name="message" 
                                  rows="3" 
                                  placeholder="Напишіть свій відгук..." 
                                  required></textarea>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-warning px-4 py-2 fw-bold text-dark rounded-3 shadow-sm btn-hover-effect">
                            Опублікувати
                        </button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <!-- Баннер с предложением авторизоваться -->
            <div class="card bg-black bg-opacity-50 border border-warning border-opacity-25 rounded-4 p-4 text-center mb-5 shadow-sm">
                <span class="fs-2 mb-2 d-block">🔒</span>
                <h5 class="text-light fw-bold">Бажаєте залишити відгук?</h5>
                <p class="text-secondary small mb-3">Залишати повідомлення в книзі можуть тільки зареєстровані користувачі.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Login" class="btn btn-auth-login btn-sm px-4">Вхід</a>
                    <a asp-action="Register" class="btn btn-auth-reg btn-sm px-4">Реєстрація</a>
                </div>
            </div>
        }

        <!-- Лента отзывов -->
        <h4 class="text-light fw-bold mb-4 d-flex align-items-center gap-2">
            <span>💬</span> Відгуки 
            <span class="badge bg-secondary bg-opacity-25 text-warning fs-6">@Model.Count()</span>
        </h4>

        @if (!Model.Any())
        {
            <div class="text-center py-5 border border-secondary border-opacity-25 rounded-4 bg-black bg-opacity-50">
                <span class="fs-1 d-block mb-2">📭</span>
                <p class="text-secondary m-0">Поки що немає жодного відгуку. Авторизуйтесь та станьте першим!</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var item in Model)
                {
                    <div class="card bg-black bg-opacity-50 border border-secondary border-opacity-25 rounded-4 p-4 shadow-sm hover-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-badge">
                                    @(item.Author.Length > 0 ? item.Author[0].ToString().ToUpper() : "U")
                                </div>
                                <span class="fw-bold text-warning">@item.Author</span>
                            </div>
                            <span class="text-secondary small">
                                @item.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </span>
                        </div>
                        <p class="text-light m-0 text-break" style="white-space: pre-line;">@item.Message</p>
                    </div>
                }
            </div>
        }

    </div>
</div>

<style>
    .avatar-badge {
        width: 34px;
        height: 34px;
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .focus-warning:focus {
        border-color: #f59e0b !important;
        box-shadow: 0 0 0 0.25rem rgba(245, 158, 11, 0.25) !important;
        background-color: #111827 !important;
        color: #fff !important;
    }

    .hover-card {
        transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .hover-card:hover {
        border-color: rgba(255, 255, 255, 0.2) !important;
        transform: translateY(-1px);
    }
</style>