@model WebGuestBook.Models.User.User    

@{
    ViewData["Title"] = "Реєстрація";
}

<div class="row justify-content-center align-items-center py-4">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="card bg-black bg-opacity-75 border border-secondary border-opacity-25 shadow-lg rounded-4 p-4 p-sm-5">
            
            <div class="text-center mb-4">
                <span class="fs-1">📝</span>
                <h2 class="fw-bold text-warning mt-2">Створення акаунта</h2>
                <p class="text-secondary small">Заповніть форму, щоб залишати відгуки в книзі</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger mb-4" role="alert"></div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-12 col-sm-6 mb-2">
                        <label asp-for="FirstName" class="form-label text-light small fw-semibold">Ім'я</label>
                        <input asp-for="FirstName" class="form-control bg-dark border-secondary border-opacity-50 text-light py-2 rounded-3 shadow-none focus-warning" placeholder="Максим" />
                        <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-sm-6 mb-2">
                        <label asp-for="LastName" class="form-label text-light small fw-semibold">Прізвище</label>
                        <input asp-for="LastName" class="form-control bg-dark border-secondary border-opacity-50 text-light py-2 rounded-3 shadow-none focus-warning" placeholder="Фіцак" />
                        <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-light small fw-semibold">Електронна пошта</label>
                    <input asp-for="Email" class="form-control bg-dark border-secondary border-opacity-50 text-light py-2 rounded-3 shadow-none focus-warning" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label text-light small fw-semibold">Пароль</label>
                    <input asp-for="Password" type="password" class="form-control bg-dark border-secondary border-opacity-50 text-light py-2 rounded-3 shadow-none focus-warning" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <button type="submit" class="btn btn-warning w-100 py-2 fw-bold text-dark rounded-3 shadow-sm btn-hover-effect">
                    Зареєструватися
                </button>
            </form>

            <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                <span class="text-secondary small">Вже зареєстровані?</span>
                <a asp-action="Login" class="text-warning text-decoration-none fw-semibold small ms-1">Увійти до системи</a>
            </div>

        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>