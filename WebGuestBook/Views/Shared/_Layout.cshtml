<!DOCTYPE html>
<html lang="uk" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Гостьова Книга</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-color: #0b0f19;
            --card-bg: rgba(18, 24, 38, 0.75);
            --border-color: rgba(255, 255, 255, 0.08);
            --accent-glow: rgba(245, 158, 11, 0.15);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(at 0% 0%, rgba(245, 158, 11, 0.08) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(59, 130, 246, 0.05) 0px, transparent 50%);
            background-attachment: fixed;
            color: var(--text-main);
        }

        /* Glassmorphism Navbar */
        .custom-navbar {
            background: rgba(11, 15, 25, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
        }

        .brand-logo {
            font-size: 1.25rem;
            letter-spacing: -0.5px;
            transition: transform 0.2s ease;
        }
        .brand-logo:hover {
            transform: scale(1.02);
        }

        /* Кнопки */
        .btn-auth-login {
            background: rgba(255, 255, 255, 0.05);
            color: #e2e8f0;
            border: 1px solid var(--border-color);
            font-weight: 600;
            border-radius: 10px;
            padding: 0.45rem 1.1rem;
            transition: all 0.25s ease;
        }
        .btn-auth-login:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-1px);
        }

        .btn-auth-reg {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #0f172a;
            border: none;
            font-weight: 700;
            border-radius: 10px;
            padding: 0.45rem 1.2rem;
            box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
            transition: all 0.25s ease;
        }
        .btn-auth-reg:hover {
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            color: #000;
            box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5);
            transform: translateY(-1px);
        }

        /* Футер */
        .custom-footer {
            background: rgba(11, 15, 25, 0.95);
            border-top: 1px solid var(--border-color);
            color: var(--text-muted);
            letter-spacing: 0.3px;
        }
    </style>
</head>
<body class="d-flex flex-column h-100">

    <!-- Верхняя шапка -->
    <header>
        <nav class="navbar custom-navbar py-3">
            <div class="container d-flex justify-content-between align-items-center">
                <!-- Назва сайту -->
                <a class="navbar-brand brand-logo text-warning d-flex align-items-center gap-2 fw-bold text-decoration-none m-0" asp-controller="GuestBook" asp-action="Index">
                    <span>📖</span> Гостьова Книга
                </a>

                <!-- Динамічний блок: якщо авторизований — кнопка Виходу, інакше — Вхід/Реєстрація -->
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="text-light small">
                            Вітаємо, <strong class="text-warning">@User.Identity.Name</strong>!
                        </span>
                        <form asp-controller="GuestBook" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-3 fw-semibold">
                                Вийти
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-auth-login btn-sm" asp-controller="GuestBook" asp-action="Login">
                            Вхід
                        </a>
                        <a class="btn btn-auth-reg btn-sm" asp-controller="GuestBook" asp-action="Register">
                            Реєстрація
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- Контентная зона (сюда подставляется Home/Index.cshtml) -->
    <main role="main" class="container flex-grow-1 py-4">
        @RenderBody()
    </main>

    <!-- Копирайт внизу -->
    <footer class="custom-footer mt-auto py-3">
        <div class="container text-center small">
            &copy; @DateTime.Now.Year <span class="text-light fw-semibold">Гостьова Книга</span>. Всі права захищено.
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>